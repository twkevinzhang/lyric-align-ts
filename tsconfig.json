{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "declaration": true, "emitDeclarationOnly": true, "outDir": "dist",
    "rootDir": "src", "verbatimModuleSyntax": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"], "exclude": ["src/worker.ts"]
}
